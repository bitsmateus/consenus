# ---------------------------------------------------------------- banco
# Local (docker compose)
DATABASE_URL="postgresql://consensus:consensus@localhost:5432/consensus_one?schema=public"
# Produção: string do Supabase, região São Paulo (sa-east-1)

# ---------------------------------------------------------------- auth
# gere com: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Segredo do dígito verificador do código de documento (HMAC).
# O cliente recusou o dígito verificador em 14/08/2026, então fica vazio:
# sem valor aqui, o sistema emite o código puro que ele especificou.
# Só preencha se a decisão mudar. Ver docs/09, item 3.
CODIGO_SEGREDO=""

# ---------------------------------------------------------------- storage
# Local: MinIO via docker compose
# Produção: MinIO no próprio VPS, em arquivos.consensusone.com.br (ver docs/07)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="br-se1"
S3_BUCKET="consensus-one"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"
# Criptografia em repouso, exigida por docs/04.
#
# O valor de exemplo é AES256 de propósito: quem copiar este arquivo sem
# pensar fica PROTEGIDO. Antes vinha vazio, e copiar para produção desligava
# a criptografia dos documentos do cliente em silêncio.
#
# Deixe VAZIO apenas no MinIO local, que recusa SSE por não ter KMS
# ("NotImplemented: Server side encryption specified but KMS is not
# configured"). Em produção, mantenha AES256 ou não defina — o padrão do
# código já é ligado.
S3_CRIPTOGRAFIA="AES256"

# Backup criptografado fora do país (Cloudflare R2)
BACKUP_S3_ENDPOINT=""
BACKUP_S3_BUCKET=""
BACKUP_S3_ACCESS_KEY_ID=""
BACKUP_S3_SECRET_ACCESS_KEY=""

# ---------------------------------------------------------------- app
NEXT_PUBLIC_URL_VERIFICACAO="http://localhost:3000/verificar"
TZ="America/Sao_Paulo"

# ---------------------------------------------------------------- backup
# O backup é cifrado com chave PÚBLICA (age): o servidor cria backup e não
# consegue abrir nenhum. A chave privada vive no gerenciador de senhas e só
# aparece na hora de restaurar, fora do servidor.
# Gere o par com: age-keygen -o consensus-backup.key
BACKUP_CHAVE_PUBLICA=""
# Só no seu computador, na hora de restaurar — NUNCA no servidor:
# BACKUP_CHAVE_PRIVADA="/caminho/consensus-backup.key"
RETENCAO_DIAS="30"
# healthchecks.io — avisa quando o backup para de rodar
# Monitoramento por "interruptor de homem morto": os scripts avisam o
# healthchecks.io SÓ quando terminam bem. Se o backup parar, o aviso não chega
# e você é alertado pelo SILÊNCIO — que é como se descobre que um backup parou
# antes de precisar dele, e não no dia em que precisar.
# Vazio aqui desliga o monitoramento. Em produção, preencha os dois.
HEALTHCHECK_URL=""        # backup do banco, 2x/dia
HEALTHCHECK_SYNC_URL=""   # réplica dos documentos, 1x/dia

# ---------------------------------------------------------------- e-mail
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_REMETENTE="nao-responda@consensusone.com.br"

# ------------------------------------------------- assinatura digital (D4Sign)
# Integração da Etapa 2. Vazio = integração desligada: o sistema continua
# funcionando com o envio manual, e o botão de assinatura não aparece.
# Token e cryptKey saem do painel da D4Sign, no menu "Dev API".
D4SIGN_TOKEN_API=""
D4SIGN_CRYPT_KEY=""
# Cofre onde os documentos são guardados na D4Sign. Descubra o UUID com:
#   curl "https://secure.d4sign.com.br/api/v1/safes?tokenAPI=...&cryptKey=..."
D4SIGN_UUID_COFRE=""
# Homologação: https://sandbox.d4sign.com.br/api/v1
# Produção:    https://secure.d4sign.com.br/api/v1  (padrão quando vazio)
D4SIGN_BASE_URL=""
# Segredo cadastrado no painel da D4Sign para o Content-Hmac dos avisos.
# Sem ele o webhook recusa TUDO — recusar é o comportamento seguro.
D4SIGN_WEBHOOK_SEGREDO=""
# Token secreto que vai no CAMINHO da URL do webhook. É defesa nossa, somada
# ao Content-Hmac, porque a D4Sign assina só o UUID do documento e esse hash
# nunca muda. Gere com: openssl rand -hex 32
D4SIGN_WEBHOOK_TOKEN=""
