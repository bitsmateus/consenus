// Sistema de Gestão da Câmara Consensus One
// Modelo de dados da Etapa 1

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- usuários

enum Papel {
  ADMIN // administra o sistema e a equipe
  OPERADOR // colaborador da câmara: conduz todo o fluxo
  PARTE // acesso externo, restrito ao próprio ato
  PROCURADOR // acesso externo, vê TODOS os atos em que representa alguém
}

model Usuario {
  id        String  @id @default(cuid())
  nome      String
  email     String  @unique
  senhaHash String
  papel     Papel   @default(OPERADOR)
  ativo     Boolean @default(true)

  // segundo fator (obrigatório para ADMIN e OPERADOR)
  totpSecret String?
  totpAtivo  Boolean @default(false)

  // proteção contra força bruta
  tentativasFalhas Int       @default(0)
  bloqueadoAte     DateTime? @db.Timestamptz(3)
  ultimoLoginEm    DateTime? @db.Timestamptz(3)

  // vínculo do perfil externo com a pessoa cadastrada
  pessoaId String? @unique
  pessoa   Pessoa? @relation(fields: [pessoaId], references: [id])

  atosCriados  Ato[]                    @relation("AtoCriadoPor")
  eventos      EventoAto[]
  auditoria    LogAuditoria[]
  documentos   Documento[]              @relation("DocumentoEnviadoPor")
  conferencias ConferenciaDeDocumento[]
  termos       TermoDeAcordo[]
  assinaturas  OperacaoAssinatura[]     @relation("AssinaturaSolicitadaPor")

  criadoEm     DateTime @default(now()) @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @db.Timestamptz(3)

  @@index([email])
}

// ---------------------------------------------------------------- pessoas

enum TipoPessoa {
  FISICA
  JURIDICA
}

/// Natureza do procurador. Um ato pode ser representado por qualquer um deles,
/// tanto do lado do Solicitante quanto do Convidado.
enum TipoProcurador {
  ADVOGADO // pessoa física com OAB
  ESCRITORIO_ADVOCACIA // pessoa jurídica
  EMPRESA // empresa que é parte interessada e atua como sua própria procuradora
  CONSULTORIA // consultoria contratada que encaminha o caso
  REPRESENTANTE_EMPRESA // pessoa física que representa a empresa/consultoria
}

model Pessoa {
  id          String     @id @default(cuid())
  tipo        TipoPessoa
  nome        String
  documento   String     @unique // CPF ou CNPJ, apenas dígitos
  email       String?
  telefone    String?
  logradouro  String?
  numero      String?
  complemento String?
  bairro      String?
  cidade      String?
  uf          String?    @db.VarChar(2)
  cep         String?

  // ---- quando a pessoa atua como procuradora ----
  tipoProcurador TipoProcurador?
  oab            String? // advogado ou escritório
  /// empresa/escritório ao qual este representante está vinculado
  vinculadoAId   String?
  vinculadoA     Pessoa?         @relation("Vinculo", fields: [vinculadoAId], references: [id])
  representantes Pessoa[]        @relation("Vinculo")

  usuario         Usuario?
  participacoes   ParteDoAto[]
  enviosRecebidos Envio[]

  criadoEm     DateTime @default(now()) @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @db.Timestamptz(3)

  @@index([documento])
  @@index([nome])
}

// ---------------------------------------------------------------- ato

enum StatusAto {
  RASCUNHO // cadastro iniciado
  AGUARDANDO_DOCUMENTACAO // 1a carta enviada ao solicitante, data reservada
  DOCUMENTACAO_EM_ANALISE // solicitante enviou, operador confere
  DATA_CONFIRMADA // operador validou os documentos, data efetivada
  CONVIDADO_CONVOCADO // 2a carta enviada ao convidado
  SESSAO_REALIZADA // aguardando lavratura da ata
  COMPOSICAO_INTEGRAL // desfechos previstos no modelo de ata do cliente
  COMPOSICAO_PARCIAL
  REDESIGNADA
  ENCERRADO_SEM_COMPOSICAO
  SESSAO_PREJUDICADA
  CANCELADO // solicitante não enviou a documentação no prazo
}

/// Desfecho registrado na Ata — as cinco opções do modelo oficial
enum DesfechoSessao {
  COMPOSICAO_INTEGRAL
  COMPOSICAO_PARCIAL
  REDESIGNACAO
  ENCERRAMENTO_SEM_COMPOSICAO
  SESSAO_PREJUDICADA
}

enum ModalidadeSessao {
  VIDEOCONFERENCIA
  PRESENCIAL
  HIBRIDA
}

model Ato {
  id     String    @id @default(cuid())
  numero String    @unique // ex.: 2026.0001
  status StatusAto @default(RASCUNHO)

  objeto String? // "Objeto do Procedimento" — vai nos documentos

  // Apelido de trabalho, editável pelo operador (pedido do cliente em 24/08).
  // NÃO substitui o número, que é a identidade oficial do procedimento e o que
  // aparece nos documentos: serve para achar o procedimento na listagem.
  titulo String?

  // agenda
  dataReservada        DateTime?        @db.Timestamptz(3) // provisória, criada no passo 2
  dataConfirmada       DateTime?        @db.Timestamptz(3) // efetivada no passo 3
  modalidade           ModalidadeSessao @default(VIDEOCONFERENCIA)
  linkVideoconferencia String?
  idReuniao            String? // "ID da reunião" do Zoom
  senhaReuniao         String? // "Senha" do Zoom
  localPresencial      String?

  // realização
  horaInicio        DateTime?       @db.Timestamptz(3)
  horaEncerramento  DateTime?       @db.Timestamptz(3)
  desfecho          DesfechoSessao?
  motivoPrejudicada String?
  observacoesSessao String?

  /// quem mais participou da sessão além das partes vinculadas — vai na Ata
  outrosPresentes   String?

  // prazos calculados na criação, a partir de ConfiguracaoSistema
  prazoDocumentacaoAte DateTime? @db.Timestamptz(3)

  /// Data em que o Interessado Solicitante RECEBEU a 1ª Carta-Convite, lida do
  /// laudo de AR. A carta conta os 15 dias do recebimento, não da emissão:
  /// "no prazo de até 15 (quinze) dias, contados do recebimento desta
  /// comunicação". Enquanto for nulo, prazoDocumentacaoAte é PROVISÓRIO e não
  /// serve de fundamento para encerrar o cadastro por perda de prazo.
  dataCienciaSolicitante DateTime? @db.Timestamptz(3)

  observacoes String?

  criadoPorId String
  criadoPor   Usuario @relation("AtoCriadoPor", fields: [criadoPorId], references: [id])

  partes        ParteDoAto[]
  documentos    Documento[]
  eventos       EventoAto[]
  envios        Envio[]
  conferencias  ConferenciaDeDocumento[]
  termoDeAcordo TermoDeAcordo?
  assinaturas   OperacaoAssinatura[]

  criadoEm     DateTime @default(now()) @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @db.Timestamptz(3)

  @@index([status])
  @@index([dataConfirmada])
}

enum PapelNoAto {
  SOLICITANTE // "Interessado Solicitante" — quem provoca o procedimento
  CONVIDADO // "Interessado Convidado" — a outra parte
  PROCURADOR
  CONCILIADOR
}

model ParteDoAto {
  id       String     @id @default(cuid())
  atoId    String
  ato      Ato        @relation(fields: [atoId], references: [id], onDelete: Cascade)
  pessoaId String
  pessoa   Pessoa     @relation(fields: [pessoaId], references: [id])
  papel    PapelNoAto

  /// quando papel = PROCURADOR, indica qual parte ele representa.
  /// Um mesmo procurador pode representar o Solicitante em um ato e o
  /// Convidado em outro — a natureza vem de Pessoa.tipoProcurador.
  representaId  String?
  representa    ParteDoAto?  @relation("Representacao", fields: [representaId], references: [id])
  representados ParteDoAto[] @relation("Representacao")

  /// registrado na sessão, para o item "III – DO COMPARECIMENTO" da ata
  compareceu         Boolean?
  observacaoPresenca String?

  criadoEm DateTime @default(now()) @db.Timestamptz(3)

  @@unique([atoId, pessoaId, papel])
  @@index([atoId])
}

// ---------------------------------------------------------------- conferência

/// Os cinco documentos que a Carta-Convite exige do Interessado Solicitante.
/// docs/08: o passo 3 confere item a item, não "recebeu ou não" — assim o
/// operador sabe exatamente o que falta antes de confirmar a data.
enum ItemDaDocumentacao {
  CONTRATO_PRESTACAO_SERVICOS // I   — com a Empresa de Consultoria e Assessoria Técnica
  PROCURACAO // II  — quando aplicável
  CONTRATO_FINANCIAMENTO // III
  PROVA_TECNICA // IV
  DOCUMENTOS_PESSOAIS // V
}

model ConferenciaDeDocumento {
  id    String             @id @default(cuid())
  atoId String
  ato   Ato                @relation(fields: [atoId], references: [id], onDelete: Cascade)
  item  ItemDaDocumentacao

  conferido    Boolean @default(false)
  /// "procuração, quando aplicável": nem todo procedimento tem procurador
  naoAplicavel Boolean @default(false)
  observacao   String?

  conferidoPorId String?
  conferidoPor   Usuario?  @relation(fields: [conferidoPorId], references: [id])
  conferidoEm    DateTime? @db.Timestamptz(3)

  @@unique([atoId, item])
  @@index([atoId])
}

// ---------------------------------------------------------------- termo de acordo

/// Campos livres do Termo de Acordo. Todo o resto do modelo é texto fixo e não
/// é editável na interface: inadimplemento, confidencialidade, força executiva
/// e quitação são decisão jurídica do cliente, não do operador que lavra o
/// termo no fim de uma sessão. Ver docs/09, item 9.
model TermoDeAcordo {
  id    String @id @default(cuid())
  atoId String @unique
  ato   Ato    @relation(fields: [atoId], references: [id], onDelete: Cascade)

  objetoDoAcordo          String // Cláusula Primeira
  obrigacoesPrimeiraParte String // Cláusula Segunda
  obrigacoesSegundaParte  String // Cláusula Terceira
  condicoesEspecificas    String? // Cláusula Quarta
  prazosDeCumprimento     String? // Seção V, § 1º
  formaDeCumprimento      String? // Seção V, § 2º
  formaDePagamento        String? // Seção V, § 3º
  demaisCondicoes         String? // Seção V, § 4º

  criadoPorId  String?
  criadoPor    Usuario? @relation(fields: [criadoPorId], references: [id])
  criadoEm     DateTime @default(now()) @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @db.Timestamptz(3)
}

// ---------------------------------------------------------------- documentos

enum TipoDocumento {
  // ---- emitidos pela esteira, com código CO-XX-ANO-NNNNNN ----
  CARTA_CONVITE_SOLICITANTE // CO-CC  · comunica cadastro e pede documentação
  CARTA_CONVITE_CONVIDADO // CO-CC  · convoca a outra parte
  ATA // CO-ATA · obrigatória em toda sessão, encerra a esteira
  TERMO_ACORDO // CO-TA  · quando há composição

  // ---- recebidos ou anexados, sem código próprio ----
  DOCUMENTO_DA_PARTE
  LAUDO_AR
  DOCUMENTO_ASSINADO
  OUTRO

  // Termo de Encerramento (CO-TE), Notificação (CO-NT) e Memorando (CO-MEM)
  // NÃO entram aqui. Decisão do cliente em 14/08/2026: são de uso
  // administrativo, fora da esteira. Ver docs/08.
}

model Documento {
  id    String        @id @default(cuid())
  atoId String
  ato   Ato           @relation(fields: [atoId], references: [id], onDelete: Cascade)
  tipo  TipoDocumento

  /// Código único impresso no cabeçalho e codificado no QR Code.
  /// Opcional de propósito: só os documentos emitidos pela esteira têm código.
  /// Documento da parte, laudo de AR e assinado são anexos, não recebem número.
  codigoVerificacao String? @unique
  emitidoPelaCamara Boolean @default(false) // true = gerado pelo sistema

  nomeArquivo  String
  chaveStorage String // caminho no bucket
  mimeType     String
  tamanhoBytes Int
  hashSha256   String // integridade do arquivo

  enviadoPorId String?
  enviadoPor   Usuario? @relation("DocumentoEnviadoPor", fields: [enviadoPorId], references: [id])

  envios        Envio[]
  comprovanteDe Envio[] @relation("ComprovanteDoEnvio")

  /// quando este documento foi enviado para assinatura
  emAssinatura       OperacaoAssinatura? @relation("DocumentoEmAssinatura")
  /// quando este documento É o PDF assinado que voltou
  assinaturaDeOrigem OperacaoAssinatura? @relation("DocumentoAssinadoDaOperacao")

  criadoEm DateTime @default(now()) @db.Timestamptz(3)

  @@index([atoId])
  @@index([codigoVerificacao])
}

// ---------------------------------------------------------------- envios

enum CanalEnvio {
  AR_DIGITAL
  EMAIL
  ENTREGA_MANUAL
}

enum StatusEnvio {
  PENDENTE
  ENVIADO
  ENTREGUE
  FALHOU
}

model Envio {
  id             String    @id @default(cuid())
  atoId          String
  ato            Ato       @relation(fields: [atoId], references: [id], onDelete: Cascade)
  documentoId    String
  documento      Documento @relation(fields: [documentoId], references: [id])
  destinatarioId String
  destinatario   Pessoa    @relation(fields: [destinatarioId], references: [id])

  canal      CanalEnvio
  status     StatusEnvio @default(PENDENTE)

  /// protocolo da AR Online (o "idEmail"), quando o envio saiu pela integração
  protocoloExterno String? @unique
  /// última descrição de status recebida da AR Online, como ela escreve
  statusExterno    String?
  enviadoEm  DateTime?   @db.Timestamptz(3)
  entregueEm DateTime?   @db.Timestamptz(3)

  // laudo de AR arquivado como documento
  comprovanteId String?
  comprovante   Documento? @relation("ComprovanteDoEnvio", fields: [comprovanteId], references: [id])

  observacao String?
  criadoEm   DateTime @default(now()) @db.Timestamptz(3)

  @@index([atoId])
}

// ------------------------------------------------------------ assinatura digital

/// Estado da operação de assinatura na D4Sign (Etapa 2).
/// ARQUIVADA é estado NOSSO, não deles: significa que o PDF assinado já foi
/// baixado e guardado aqui. Enquanto não estiver arquivada, o documento
/// assinado só existe na D4Sign — e depender disso seria depender de terceiro.
enum StatusAssinatura {
  AGUARDANDO // criada, ninguém assinou ainda
  PARCIAL // ao menos um signatário assinou
  CONCLUIDA // todos assinaram; o assinado ainda não foi baixado
  ARQUIVADA // assinado baixado e guardado no nosso repositório
  CANCELADA
  FALHOU // erro ao baixar ou arquivar — exige ação do operador
}

/// Uma operação de assinatura = um documento emitido (Ata ou Termo de Acordo)
/// enviado à D4Sign. O documento assinado que volta vira outro Documento,
/// do tipo DOCUMENTO_ASSINADO, ligado aqui por `assinadoId`.
model OperacaoAssinatura {
  id          String    @id @default(cuid())
  atoId       String
  ato         Ato       @relation(fields: [atoId], references: [id], onDelete: Cascade)
  documentoId String    @unique // um documento vai para assinatura uma vez só
  documento   Documento @relation("DocumentoEmAssinatura", fields: [documentoId], references: [id])

  /// UUID do documento na D4Sign. É por ele que o webhook nos encontra e é com
  /// ele que se baixa o PDF assinado.
  identificadorExterno String @unique

  status StatusAssinatura @default(AGUARDANDO)

  /// quantos signatários foram enviados e quantos já assinaram, para a tela
  totalSignatarios Int @default(0)
  jaAssinaram      Int @default(0)

  /// o PDF assinado, depois de baixado e guardado
  assinadoId String?    @unique
  assinado   Documento? @relation("DocumentoAssinadoDaOperacao", fields: [assinadoId], references: [id])

  /// última falha técnica, para o operador saber o que aconteceu
  ultimoErro String?

  solicitadaPorId String?
  solicitadaPor   Usuario? @relation("AssinaturaSolicitadaPor", fields: [solicitadaPorId], references: [id])

  concluidaEm  DateTime? @db.Timestamptz(3)
  criadoEm     DateTime  @default(now()) @db.Timestamptz(3)
  atualizadoEm DateTime  @updatedAt @db.Timestamptz(3)

  @@index([atoId])
  @@index([status])
}

/// Webhook já processado. A D4Sign reenvia até 7 vezes ao longo de ~27 horas
/// quando não recebe resposta, então a mesma notificação chega mais de uma vez
/// em operação normal — sem esta trava, um reenvio arquivaria o mesmo documento
/// assinado duas vezes.
model WebhookAssinatura {
  id    String @id @default(cuid())
  /// documento + tipo do aviso + signatário. O signatário entra porque o aviso
  /// de assinatura dispara uma vez por pessoa, todos com o mesmo UUID.
  chave String @unique

  identificadorExterno String
  tipoDoAviso          String
  recebidoEm           DateTime @default(now()) @db.Timestamptz(3)

  @@index([identificadorExterno])
}

// ---------------------------------------------------------------- linha do tempo

enum TipoEvento {
  ATO_CRIADO
  PARTE_ADICIONADA
  CARTA_SOLICITANTE_GERADA
  CARTA_SOLICITANTE_ENVIADA
  DOCUMENTO_RECEBIDO
  DOCUMENTACAO_CONFERIDA
  DATA_CONFIRMADA
  CARTA_CONVIDADO_GERADA
  CARTA_CONVIDADO_ENVIADA
  SESSAO_REALIZADA
  ATA_GERADA
  TERMO_GERADO
  ASSINATURA_SOLICITADA
  ASSINATURA_REGISTRADA
  ASSINATURA_CONCLUIDA
  ASSINATURA_CANCELADA
  DOCUMENTO_ASSINADO_ANEXADO
  ATO_CONCLUIDO
  ATO_CANCELADO
  OBSERVACAO
}

model EventoAto {
  id        String     @id @default(cuid())
  atoId     String
  ato       Ato        @relation(fields: [atoId], references: [id], onDelete: Cascade)
  tipo      TipoEvento
  descricao String
  usuarioId String?
  usuario   Usuario?   @relation(fields: [usuarioId], references: [id])
  metadados Json?
  criadoEm  DateTime   @default(now()) @db.Timestamptz(3)

  @@index([atoId, criadoEm])
}

// ---------------------------------------------------------------- auditoria

model LogAuditoria {
  id         String   @id @default(cuid())
  usuarioId  String?
  usuario    Usuario? @relation(fields: [usuarioId], references: [id])
  acao       String // LOGIN, DOWNLOAD_DOCUMENTO, ALTEROU_ATO, ...
  entidade   String // Ato, Documento, Usuario
  entidadeId String?
  ip         String?
  userAgent  String?
  metadados  Json?
  criadoEm   DateTime @default(now()) @db.Timestamptz(3)

  @@index([usuarioId, criadoEm])
  @@index([entidade, entidadeId])
}

// ---------------------------------------------------------------- configuração

model ConfiguracaoSistema {
  id                    Int      @id @default(1)
  nomeCamara            String   @default("Consensus One")
  /// 15 dias, conforme a Carta-Convite ao Interessado Solicitante
  prazoDocumentacaoDias Int      @default(15)
  /// aviso mínimo para mudar a modalidade da sessão
  horasAvisoModalidade  Int      @default(48)
  diasAteSessao         Int      @default(30)
  /// horário padrão da sessão, usado na Carta-Convite e no agendamento do Zoom
  horaDaSessao          String   @default("14:00")
  /// duração prevista, para a reunião do Zoom nascer com fim previsto
  duracaoSessaoMinutos  Int      @default(90)
  urlVerificacao        String   @default("https://consensusone.com.br/verificar")
  emailRemetente        String?
  atualizadoEm          DateTime @updatedAt @db.Timestamptz(3)
}
